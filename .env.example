# Copia este archivo a .env.local y rellena con los valores de TU proyecto Supabase.
# .env.local está en .gitignore — el repo es público, jamás commitear claves reales.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SOLO servidor (sin NEXT_PUBLIC): clave secreta / service role
SUPABASE_SECRET_KEY=sb_secret_xxx

# Para scripts/seed-admin.mjs (primer administrador)
SEED_ADMIN_EMAIL=admin@vitalfit.local
SEED_ADMIN_PASSWORD=cambiar-esta-clave
